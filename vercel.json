{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{staticfiles,static,templates}/**"
    }
  },
  "crons": [{ "path": "/cron/daily/", "schedule": "30 21 * * *" }]
}
