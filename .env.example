# Copy to ".env" next to manage.py. No quotes needed. NEVER share or commit the real file.

# --- AI (free options): Gemini, Groq, or local Ollama ---
GEMINI_API_KEY=
# GROQ_API_KEY=

# --- Production (DEBUG=0) ---
# DEBUG=0
# SECRET_KEY=<long random string, 32+ chars>      python -c "import secrets;print(secrets.token_urlsafe(50))"
# ALLOWED_HOSTS=school.example.com
# CSRF_TRUSTED_ORIGINS=https://school.example.com
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require   (Neon / Vercel; overrides DB_*)
# CRON_SECRET=<random>      enables /cron/daily/ (Vercel Cron)
# DB_ENGINE=postgres
# DB_HOST=localhost
# DB_NAME=edupulse
# DB_USER=edupulse
# DB_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# --- Email notifications (parents/students) ---
# EMAIL_NOTIFICATIONS=1
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=EduPulse <no-reply@school.example.com>
